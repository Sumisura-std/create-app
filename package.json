{
  "name": "@sumisura/create-app",
  "version": "0.1.0",
  "description": "Scaffold a new project from a Sumisura template",
  "type": "module",
  "license": "MIT",
  "repository": "github:Sumisura-std/create-app",
  "bin": {
    "create-app": "dist/index.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --packages external",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/index.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "giget": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
